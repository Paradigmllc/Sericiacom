# Dedicated Medusa database and Redis. Never reuse another app's database.
DATABASE_URL=postgres://medusa:REPLACE_ME@localhost:5432/sericia_medusa
REDIS_URL=redis://localhost:6379/0
# false is only suitable for private local/overlay networking.
DATABASE_SSL=false
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
STORE_CORS=https://sericia.com
ADMIN_CORS=https://api.sericia.com
AUTH_CORS=https://sericia.com,https://api.sericia.com
NODE_ENV=production
MEDUSA_WORKER_MODE=server

# Remains disabled until Stripe test flow and launch requirements pass.
STRIPE_ENABLED=false
SERICIA_LIVE_PAYMENTS=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2: setting S3_BUCKET requires all five values.
S3_BUCKET=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RESEND_API_KEY=
